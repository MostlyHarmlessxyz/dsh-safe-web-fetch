{
  "name": "dsh-safe-web-fetch",
  "version": "0.1.0-next.0",
  "description": "SSRF-resistant HTTP(S) fetch provider for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssrf",
    "web-fetch",
    "security",
    "cordis"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MostlyHarmlessxyz/dsh-safe-web-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/MostlyHarmlessxyz/dsh-safe-web-fetch/issues"
  },
  "homepage": "https://github.com/MostlyHarmlessxyz/dsh-safe-web-fetch#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import=tsx tests/*.test.ts",
    "test:coverage": "node --test --import=tsx --experimental-test-coverage tests/*.test.ts",
    "pack:check": "npm pack --dry-run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.5 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1 <4",
    "ipaddr.js": "2.5.0",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
